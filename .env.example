# Copy to .env and replace the placeholders. Never commit .env.
# Generate values with, for example:  openssl rand -hex 32

# Password for the PostgreSQL user (used by both the db and app containers)
POSTGRES_PASSWORD=change-me

# Secret for signing login tokens: at least 32 characters, random
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters

# Optional: turn Swagger UI on in the Docker image (it's off by default in production)
# SWAGGER_ENABLED=true
